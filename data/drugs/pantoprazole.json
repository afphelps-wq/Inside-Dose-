  "journey": [
    {
      "step": "absorption",
      "organ": "intestines",
      "text": "Its coating protects it from stomach acid; it is absorbed after leaving the stomach, peaking about 2.5 hours later."
    },
    {
      "step": "action",
      "organ": "stomach",
      "text": "Locks onto the proton pumps in the stomach lining that make acid; the effect lasts more than a day."
    },
    {
      "step": "metabolism",
      "organ": "liver",
      "text": "Broken down in the liver, mainly by the CYP2C19 enzyme; it is gone from the blood within hours."
    },
    {
      "step": "elimination",
      "organ": "kidneys",
      "text": "About 71% leaves in urine as broken-down pieces and 18% through bile."
