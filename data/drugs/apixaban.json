  "journey": [
    {
      "step": "absorption",
      "organ": "intestines",
      "text": "Absorbed from the gut. About half of each dose reaches the blood, with or without food."
    },
    {
      "step": "action",
      "organ": "blood_vessels",
      "text": "Blocks factor Xa, a clotting protein in the blood, so clots form more slowly."
    },
    {
      "step": "metabolism",
      "organ": "liver",
      "text": "Partly broken down in the liver, mainly by the CYP3A4 enzyme. Most of the drug in the blood stays unchanged."
    },
    {
      "step": "elimination",
      "organ": "kidneys",
      "text": "About a quarter leaves through the kidneys in urine; the rest leaves through the gut."
    }
