  "journey": [
    {
      "step": "absorption",
      "organ": "intestines",
      "text": "Absorbed well from the gut, with or without food; blood levels peak about 5 hours later."
    },
    {
      "step": "action",
      "organ": "brain",
      "text": "Blocks serotonin from being taken back up by nerve cells in the brain, so more serotonin stays active."
    },
    {
      "step": "metabolism",
      "organ": "liver",
      "text": "Broken down in the liver, mainly by the CYP2C19 and CYP3A4 enzymes."
    },
    {
      "step": "elimination",
      "organ": "kidneys",
      "text": "About a fifth of a dose leaves in urine; the rest is broken down first."
    }
  ],
