  "journey": [
    {
      "step": "absorption",
      "organ": "intestines",
      "text": "Well absorbed from the gut, but much is changed by the liver on the first pass; about a third reaches the blood unchanged."
    },
    {
      "step": "metabolism",
      "organ": "liver",
      "text": "The liver turns part of it, mainly with the CYP2C9 enzyme, into a stronger active form that does most of the work."
    },
    {
      "step": "action",
      "organ": "blood_vessels",
      "text": "Blocks angiotensin II from tightening blood vessels, so they relax and blood pressure drops."
    },
    {
      "step": "elimination",
      "organ": "intestines",
      "text": "Leaves through bile into the gut (about 60%) and in urine (about 35%)."
    }
