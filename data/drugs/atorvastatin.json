  "journey": [
    {
      "step": "absorption",
      "organ": "intestines",
      "text": "Absorbed quickly from the gut, but only about 14% reaches the blood unchanged; much is broken down first in the gut wall and liver."
    },
    {
      "step": "action",
      "organ": "liver",
      "text": "Blocks HMG-CoA reductase, the enzyme the liver uses to make cholesterol, and helps the liver pull LDL (\"bad\") cholesterol out of the blood."
    },
    {
      "step": "metabolism",
      "organ": "liver",
      "text": "Broken down mainly by the CYP3A4 enzyme into pieces that keep working."
    },
    {
      "step": "elimination",
      "organ": "intestines",
      "text": "Leaves mainly in bile, the digestive fluid the liver sends into the gut. Less than 2% leaves in urine."
    }
